PORT=3006
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/ml_db?authSource=admin
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=change-this-secret-in-production

# Mercado Livre OAuth 2.0
# Get your App ID from: https://developers.mercadolibre.com.br/
ML_CLIENT_ID=your-ml-app-id
ML_CLIENT_SECRET=your-ml-client-secret
ML_REDIRECT_URI=http://localhost:3006/ml/auth/callback

# Optional: set a direct access token to skip the OAuth flow (useful for testing)
# ML_ACCESS_TOKEN=APP_USR-...
# ML_REFRESH_TOKEN=TG-...

# Internal service URLs (for forwarding orders)
ORDER_SERVICE_URL=http://localhost:3004
PRODUCT_SERVICE_URL=http://localhost:3002

# Webhook secret used to verify incoming ML notifications
ML_WEBHOOK_SECRET=change-this-webhook-secret
