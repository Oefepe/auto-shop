PORT=3007
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/meta_db?authSource=admin
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=change-this-secret-in-production

# Meta / Facebook Graph API
# Get your access token from: https://developers.facebook.com/
META_ACCESS_TOKEN=your-meta-access-token-here
META_CATALOG_ID=your-catalog-id-here
META_APP_SECRET=your-meta-app-secret-here

# Webhook verify token — a string YOU define; register it in the Meta app webhook settings
META_WEBHOOK_VERIFY_TOKEN=change-this-verify-token

# Internal service URLs
ORDER_SERVICE_URL=http://localhost:3004
PRODUCT_SERVICE_URL=http://localhost:3002
