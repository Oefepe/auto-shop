PORT=3008
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/notifications_db?authSource=admin
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=change-this-secret-in-production

# SMTP — works with Gmail (use App Password), SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_FROM="Auto-Shop Alerts <noreply@auto-shop.com>"

# Default email recipients for low-stock alerts (comma-separated)
ALERT_RECIPIENTS=admin@yourshop.com

# Hours to wait before re-sending a low-stock alert for the same SKU
COOLDOWN_HOURS=4
